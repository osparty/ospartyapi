    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "redis_connected_clients{namespace=\"osparty-dev\"}",
     "legendFormat": "clients"
    }
   ]
  },
