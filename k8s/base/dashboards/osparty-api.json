    {
      "type": "stat",
      "title": "Service status",
      "description": "One card per running instance (instant query — only pods that exist right now). Green = Prometheus scrape succeeded, red = down. The 'API pods up' stat catches a missing replica.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 58
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
