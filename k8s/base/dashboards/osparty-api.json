    {
      "type": "timeseries",
      "title": "Socket connections by endpoint",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Open connections by the endpoint they arrived on. `mux` is the merged socket (one connection carrying both protocols); `board` and `live` are the single-protocol endpoints kept for clients that predate it. Retiring those is safe once they sit at zero.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (endpoint) (osparty_ws_connections{namespace=\"osparty\",application=\"osrs-party-api\"})",
          "legendFormat": "{{endpoint}}"
        }
      ]
    },
